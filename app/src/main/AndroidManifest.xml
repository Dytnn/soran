<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS 전용 앱 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <!-- 음성 메모 (앱 마이크 모드에서 원본 음성 저장) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 위치 + 재방문 근접 알림 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AAOS 표준 차량 속성 (CarPropertyManager) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />                 <!-- PERF_VEHICLE_SPEED -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />            <!-- GEAR_SELECTION, PARKING_BRAKE_ON -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />  <!-- ENV_OUTSIDE_TEMPERATURE -->

    <!-- Pleos Connect SDK -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- Vehicle SDK 의 Seat/Odometer 도메인을 쓰게 되면 추가: CAR_SEATS, CAR_DRIVE -->

    <application
        android:name=".SoranApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Soran"
        tools:targetApi="34">

        <!-- AAOS: 주행 중에도 화면을 띄울 수 있도록 Distraction Optimized 로 선언.
             주행 중 제한은 앱이 CarUxRestrictions 를 받아 직접 적용해요 (DrivingGate). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 재방문 근접 알림 수신 (LocationManager.addProximityAlert) -->
        <receiver
            android:name=".location.ProximityReceiver"
            android:exported="false" />
    </application>
</manifest>
